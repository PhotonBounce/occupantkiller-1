{
  "name": "occupantkiller",
  "version": "1.0.0",
  "description": "A browser-based first-person shooter built with [Three.js](https://threejs.org/).   Survive 10 waves of increasingly dangerous **occupants** before they overrun you.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx --yes serve -l 3000 .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:build": "electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lindapot-art/occupantkiller.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lindapot-art/occupantkiller/issues"
  },
  "homepage": "https://github.com/lindapot-art/occupantkiller#readme",
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "canvas": "^3.2.3",
    "jimp": "^1.6.1",
    "pm2": "^5.4.3",
    "puppeteer": "^24.40.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.photonbounce.occupantkiller",
    "productName": "OccupantKiller",
    "asar": false,
    "directories": {
      "output": "../dist"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "index.html",
      "*.js",
      "*.css",
      "*.json",
      "favicon.ico",
      "gamemusic/**/*",
      "audio/**/*",
      "assets/**/*",
      "textures/**/*",
      "models/**/*",
      "!**/node_modules/**",
      "!microsite/**",
      "!admin/**",
      "!backend/**",
      "!contracts/**",
      "!apk-build/**",
      "!build/**",
      "!photon-*/**",
      "!wp-integration/**",
      "!reference/**",
      "!supergame_extracted/**",
      "!memories/**",
      "!tools/**",
      "!**/*.apk",
      "!**/*.aab",
      "!**/*.zip",
      "!**/*.md",
      "!.git/**",
      "!.github/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OccupantKiller"
    }
  }
}
