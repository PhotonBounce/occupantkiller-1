{
  "name": "occupant-killer-desktop",
  "productName": "OccupantKiller",
  "version": "1.0.0",
  "description": "Occupant Killer \u2014 desktop edition",
  "main": "main.js",
  "author": "PhotonBounce",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.photonbounce.occupantkiller",
    "productName": "OccupantKiller",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "dir"
      ],
      "artifactName": "OccupantKiller-${version}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "OccupantKiller-${version}-portable.exe"
    },
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Occupant Killer",
      "artifactName": "OccupantKiller-${version}-setup.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}